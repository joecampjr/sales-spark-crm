// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String    @id @default(uuid())
  name        String
  cnpj        String    @unique
  status      String    @default("ACTIVE") // ACTIVE, SUSPENDED
  suspendedAt DateTime?

  planName      String?   @default("Plano Premium")
  planValue     Float?    @default(499.00)
  nextDueDate   DateTime?
  paymentStatus String?   @default("PAID") // PAID, PENDING, OVERDUE

  branches     Branch[]
  users        User[]
  sellers      Seller[]
  leads        Lead[]
  interactions Interaction[]
  visits       Visit[]
  salesActions SalesAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  city      String
  state     String
  address   String?
  phone     String?
  email     String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sellers   Seller[]
  users     User[]
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String?  @unique
  password String // Hash da senha
  role     String  @default("VENDEDOR") // SUPERADMIN, ADMIN, SUPERVISOR, GERENTE, VENDEDOR
  cpf      String? // CPF do usuário

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller?

  @@index([companyId])
  @@index([branchId])
}

model Seller {
  id             String  @id @default(uuid())
  name           String
  email          String? @unique
  phone          String?
  avatar         String?
  region         String?
  status         String  @default("ativo")
  commissionRate         Float   @default(0.0)
  commissionRateInternal Float   @default(0.0)
  commissionRateExternal Float   @default(0.0)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  salesCount     Int   @default(0)
  conversionRate Float @default(0.0)
  activeLeads    Int   @default(0)
  contactsToday  Int   @default(0)
  contactsTarget Int   @default(10)
  monthlyGoal    Float @default(0.0)

  leads        Lead[]
  interactions Interaction[]
  visits       Visit[]
  salesActions SalesActionStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
}

model Lead {
  id             String @id @default(uuid())
  name           String
  phone          String
  city           String
  state          String
  status         String
  priority       String
  estimatedValue Float?
  paymentMode    String?
  downPayment    Float?
  saleType       String?
  source         String
  cpf            String?
  birthday       String?
  avgDelayDays   Int?
  route          String?
  productType    String?
  lastPurchaseDate DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  sellerId     String?
  seller       Seller?           @relation(fields: [sellerId], references: [id])
  interactions Interaction[]
  visits       Visit[]
  actionLeads  SalesActionLead[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([sellerId])
  @@index([status])
  @@index([phone])
  @@index([cpf])
}

model Interaction {
  id       String @id @default(uuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  type         String
  result       String
  productType  String?
  notes        String?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([sellerId])
  @@index([companyId])
}

model Visit {
  id       String @id @default(uuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  address        String
  visitDate      DateTime
  status         String
  notes          String?
  result         String?
  authorizedById String?
  authorizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([sellerId])
  @@index([companyId])
}

model SalesAction {
  id           String   @id @default(uuid())
  title        String
  region       String
  startDate    DateTime
  endDate      DateTime
  salesTarget  Float    @default(0)
  estimatedCost Float?   @default(0)
  status       String
  observations String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  staffCount  Int                @default(0)
  staff       SalesActionStaff[]
  targetLeads SalesActionLead[]

  reportContent     String?
  reportResult      String?
  reportRealCost    Float?
  reportRealSales   Float?
  reportSubmittedAt DateTime?

  authorizedById String?
  authorizedAt   DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalesActionStaff {
  id            String      @id @default(uuid())
  salesActionId String
  salesAction   SalesAction @relation(fields: [salesActionId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SalesActionLead {
  id            String      @id @default(uuid())
  salesActionId String
  salesAction   SalesAction @relation(fields: [salesActionId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  result        String?
  feedback      String?
}
